# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Python bytecode from the one-off asset scripts in scripts/
__pycache__/

# The offline Sports2D reference tool: its virtual environment holds model
# weights, and clips/ and out/ hold running videos and their derivatives.
# Neither belongs in a repository whose whole point is that videos stay put.
tools/sports2d/.venv/
tools/sports2d/clips/
tools/sports2d/out/

# The larger MediaPipe pose models, fetched for the model comparison rather
# than shipped. lite is tracked because the app loads it; full (9.4 MB) and
# heavy (30.7 MB) are measurement inputs and 40 MB of binary nobody has
# decided to adopt yet. tools/sports2d/README.md says how to fetch them, and
# docs/6단계-타당성.md has what they showed. If full is adopted, take it out of
# here — it has to ship for the app to load it.
public/models/pose_landmarker_full.task
public/models/pose_landmarker_heavy.task
